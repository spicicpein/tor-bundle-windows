// ============================================================================
// config_full_example.json — справочный пример СО ВСЕМИ параметрами и
// комментариями к каждому.
//
// ВАЖНО: это НЕ рабочий файл. Обычный JSON (который читает программа) не
// поддерживает комментарии — если оставить их и переименовать этот файл в
// config.json, программа не запустится. Используйте этот файл только как
// "эталон", откуда копируете нужные значения в свой настоящий
// slake/config.json (без комментариев, чистый JSON).
// ============================================================================
{
  // Адрес, на котором слушает SOCKS5+HTTP-прокси.
  // "127.0.0.1" — доступ только с этого компьютера (безопасно, по умолчанию).
  // "0.0.0.0"   — доступ с любых устройств в вашей локальной сети.
  "listen_address": "127.0.0.1",

  // Один порт для SOCKS5 И HTTP(CONNECT) сразу — программа сама определяет
  // протокол по первому байту соединения.
  "proxy_port": 9050,

  // Один или несколько портов Hidden Service — все на ОДНОМ и том же
  // .onion-адресе (используется один и тот же постоянный ключ).
  "onion_services": [
    // Пример: проброс SSH
    { "onion_port": 22, "forward_to": "127.0.0.1:22" },
    // Пример: проброс веб-панели, слушающей локально на 8080
    { "onion_port": 80, "forward_to": "127.0.0.1:8080" }
  ],

  // Мосты, вписанные вручную. Пусто = пробовать прямое подключение.
  // Поддерживаются только обфускация obfs4 и webtunnel (см. HELP-bridges.txt
  // за подробностями и за тем, как их получить).
  "bridges": [
    // -- пример строки типа obfs4 --
    "obfs4 185.220.101.1:443 4CA5E1B87D5E7E7F9C1234567890ABCDEF12345 cert=AbCdEfGhIjKlMnOpQrStUvWxYz1234567890AbCdEfGhIjKlMnOpQrStUvWxYz iat-mode=0",
    // -- ещё один obfs4, про запас (если первый заблокируют) --
    "obfs4 51.15.79.107:990 7B9C2D3E4F5061728394A5B6C7D8E9F001122334 cert=QrStUvWxYz1234567890AbCdEfGhIjKlMnOpQrStUvWxYz1234567890AbCd iat-mode=0",
    // -- пример строки типа webtunnel --
    "webtunnel 45.33.10.20:443 9F8E7D6C5B4A3210FEDCBA0987654321FEDCBA09 url=https://example-site.com/path ver=0.0.1"
  ],

  // Свой собственный сборщик мостов (см. README сборщика — отдельный
  // репозиторий tor-bridges-feed). Используется АВТОМАТИЧЕСКИ, только если
  // "bridges" выше пуст и прямое подключение похоже на заблокированное.
  // Можно указать несколько адресов — пробуются по очереди.
  "bridge_source": {
    "urls": [
      "https://raw.githubusercontent.com/spicicpein/tor-bridges-feed/main/bridges.json"
      // можно добавить второй, независимый от GitHub, адрес — на случай,
      // если именно этот заблокируют или удалят:
      // , "https://ваш-запасной-адрес.example/bridges.json"
    ]
  },

  // Встроенный DNS-сервер (порт 53). Выключен по умолчанию.
  "dns": {
    // true — поднять DNS-сервер (с фолбэком 0.0.0.0:53 -> 127.0.0.1:53 ->
    // тихое отключение, если оба заняты)
    "enabled": false,
    // true — резолвить имена через Tor (провайдер не видит запросы),
    // false — резолвить как обычно, просто через встроенный сервер
    "over_tor": true
  }
}
